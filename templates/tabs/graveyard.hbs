{{#with graveyard}}
<div class="tab" data-tab="graveyard">
  {{#if isGM}}<div class="tab-header"><button id="grave-add-btn" class="btn-primary"><i class="fas fa-plus"></i> Registrar Morte</button></div>{{/if}}
  <div class="cemetery-grid">
    {{#each graves}}
    <div class="grave-card card" data-grave-id="{{id}}">
      {{#if isGM}}<button class="edit-grave-btn icon-btn"><i class="fas fa-pencil-alt"></i></button><button class="delete-grave-btn icon-btn danger"><i class="fas fa-trash"></i></button>{{/if}}
      <h3>{{name}}</h3><p>{{deathDateFmt}}</p>
      <button class="f-btn {{#if hasRespected}}f-pressed{{/if}}">🌹</button>
      <span class="f-count">{{respectCount}}</span>
    </div>
    {{else}}<div class="empty-state"><p>Nenhum herói caiu ainda.</p></div>{{/each}}
  </div>
</div>
{{/with}}
