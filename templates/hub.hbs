<div class="social-hub-window">
  <nav class="social-tabs tabs" data-group="social">
    <a class="item" data-tab="feed"><i class="fas fa-scroll"></i> Feed</a>
    {{#each navTabs}}
    <a class="item" data-tab="{{id}}"><i class="{{icon}}"></i> {{label}}</a>
    {{/each}}
  </nav>

  <div class="social-content">
    <div class="tab" data-tab="feed">
      <div class="social-compose card">
        <textarea id="social-post-content" placeholder="Compartilhe algo com o reino…" rows="3"></textarea>
        <div class="compose-row">
          <select id="social-post-type">
            {{#if canCreateNormalPost}}<option value="post">Publicação</option>{{/if}}
            {{#if canCreateSummary}}<option value="summary">Resumo de Sessão</option>{{/if}}
          </select>
          {{#if hasSummaryMissions}}
          <select id="social-post-mission" name="missionId" style="display:none">
            <option value="">— vincular missão —</option>
            {{#each missions}}
              <option value="{{id}}">{{title}}</option>
            {{/each}}
          </select>
          {{else}}
          <div class="compose-no-mission-msg" style="display:none">Você não possui missões para vincular.</div>
          {{/if}}
          <button id="social-post-submit" class="btn-primary"><i class="fas fa-paper-plane"></i> Publicar</button>
        </div>
      </div>
      <div class="feed-list">
        {{#each posts}}
        <div class="post-card card" data-post-id="{{id}}">
          <div class="post-header">
            <div class="post-author">{{authorName}}</div>
            <div class="post-meta">
              <span class="post-date">{{createdAtFmt}}</span>
              <div class="post-actions">
                {{#if canEdit}}<button class="edit-post-btn post-edit-btn icon-btn"><i class="fas fa-pen"></i></button>{{/if}}
                {{#if canDelete}}<button class="delete-post-btn post-delete-btn icon-btn"><i class="fas fa-trash"></i></button>{{/if}}
              </div>
            </div>
          </div>
          <div class="post-body">{{{content}}}</div>
          {{#if missionName}}<div class="post-mission">Missão vinculada: {{missionName}}</div>{{/if}}
          <div class="post-reactions">
            {{#each reactionList}}
            <div class="reaction">
              <button class="react-btn {{#if active}}active{{/if}}" data-emoji="{{emoji}}">{{emoji}} {{count}}</button>
              <div class="avatars">
                {{#each users}}
                <img src="{{img}}" title="{{name}}" />
                {{/each}}
              </div>
            </div>
            {{/each}}
          </div>
          {{#if (eq type "summary")}}
          <div class="mission-rating">
            <div class="rating">
              {{#each (range 1 5)}}
              <button class="rate-btn star {{#if (eq this ../myRating)}}active{{/if}}" data-rating="{{this}}">★</button>
              {{/each}}
            </div>
            <span class="avg">{{ratingStats.avg}}</span>
          </div>
          {{/if}}
        </div>
        {{/each}}
      </div>
    </div>

    {{#if features.missions}}{{> tabs/missions}}{{/if}}
    {{#if features.graveyard}}{{> tabs/graveyard}}{{/if}}
    {{#if features.polls}}{{> tabs/polls}}{{/if}}
    {{#if features.arena}}{{> tabs/arena}}{{/if}}
    {{#if features.patches}}{{> tabs/patches}}{{/if}}
  </div>
</div>
